NODE_ENV=development
PORT=5001

REDIS_PORT=6379

MONGO_URI=


REDIS_URL=
REDIS_CACHE_TTL=3600
REDIS_MAX_RETRIES=3


# Cache Configuration
CACHE_ENABLED=true
CACHE_WARMUP_ENABLED=true
